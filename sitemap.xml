<?xml version="1.0" encoding="UTF-8"?>
<!-- 三个语言页面互为 alternate；根路径 / 由 vercel.json 的 308 跳到 /zh/，故不收录。
     主域名是 www.mewbaka.cn，apex 会跳到 www，这里一律写 www，
     否则 canonical / hreflang 全都指向会跳转的 URL。
     每个 <url> 都要列全整组 hreflang（含自身与 x-default），少一条 Google 会忽略整组。 -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <url>
    <loc>https://www.mewbaka.cn/zh/</loc>
    <xhtml:link rel="alternate" hreflang="zh-CN" href="https://www.mewbaka.cn/zh/"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://www.mewbaka.cn/en/"/>
    <xhtml:link rel="alternate" hreflang="ja" href="https://www.mewbaka.cn/ja/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://www.mewbaka.cn/zh/"/>
    <lastmod>2026-08-10</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://www.mewbaka.cn/en/</loc>
    <xhtml:link rel="alternate" hreflang="zh-CN" href="https://www.mewbaka.cn/zh/"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://www.mewbaka.cn/en/"/>
    <xhtml:link rel="alternate" hreflang="ja" href="https://www.mewbaka.cn/ja/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://www.mewbaka.cn/zh/"/>
    <lastmod>2026-08-10</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://www.mewbaka.cn/ja/</loc>
    <xhtml:link rel="alternate" hreflang="zh-CN" href="https://www.mewbaka.cn/zh/"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://www.mewbaka.cn/en/"/>
    <xhtml:link rel="alternate" hreflang="ja" href="https://www.mewbaka.cn/ja/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://www.mewbaka.cn/zh/"/>
    <lastmod>2026-08-10</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
</urlset>
